# Salin ke .env (tidak ikut git) lalu isi. JANGAN commit nilai rahasia, jangan tempel di chat.
# Muat sebelum bekerja:  set -a; source .env; set +a

# --- GitHub (rahasia) ---
# Fine-grained personal access token, dibatasi ke satu repo, izin Contents dan Pull requests read-write.
# Repo kerja: Cat-tj/compro-sentra (branch static-site-remodel). Repo resmi: Sentra-Technology/compro-sentra.
GITHUB_TOKEN=
GITHUB_REPO=Cat-tj/compro-sentra
GITHUB_BRANCH=static-site-remodel

# --- Vercel ---
# Token dibatasi ke team sentratech (rahasia).
VERCEL_TOKEN=
# ID berikut bukan rahasia; dengan keduanya, `vercel` tidak perlu `vercel link`.
VERCEL_ORG_ID=team_XcVD3k8gAm6uOtyZ3LoFpR3v
VERCEL_PROJECT_ID=prj_fygmrx33Xr35RiqKSVPvTpZEdtFa
VERCEL_SCOPE=sentratech
# Opsional (rahasia): Protection Bypass for Automation, agar curl bisa membuka preview yang diproteksi.
# Vercel > Project > Settings > Deployment Protection > Protection Bypass for Automation.
# Pakai sebagai header:  curl -H "x-vercel-protection-bypass: $VERCEL_BYPASS_SECRET" <url-preview>
VERCEL_BYPASS_SECRET=

# --- Situs dan IndexNow (bukan rahasia) ---
SITE_HOST=www.sentratechnology.com
# Kunci IndexNow sudah publik di site/d01773ca34bcf938cfbdbeff95ad2284.txt dan tertanam di tools/indexnow.py.
INDEXNOW_KEY=d01773ca34bcf938cfbdbeff95ad2284

# --- Opsional, bila pemilik sudah menyiapkan ---
# Kode verifikasi Google Search Console (isi isi meta tag google-site-verification), lalu pasang di 5 beranda.
GOOGLE_SITE_VERIFICATION=
# Akun layanan Google (JSON) hanya bila Search Console API dipakai. Simpan sebagai file di luar repo.
GOOGLE_APPLICATION_CREDENTIALS=
